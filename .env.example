# Все ключи необязательны: без них демо работает в режиме ключевых слов и веб-страницы родственника.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
TELEGRAM_BOT_TOKEN=

# Период охлаждения (сек). В продакшене 24 ч, в демо 60 с.
COOLING_SECONDS=60
# Пауза между репликами готовых сценариев (сек)
SCENARIO_DELAY=2.5
# Фоновый поток «обычных» переводов для живой ленты аналитика (1/0)
BACKGROUND_ACTIVITY=1
# Ключ ведущего/аналитика (сброс демо, кнопки аналитика). Пусто — сгенерируется в data/secrets.json и
# напечатается в логе. С этого же компьютера (localhost) ключ не нужен.
ADMIN_KEY=
# Секрет для ключей доверенного лица. Пусто — сгенерируется в data/secrets.json.
SECRET_KEY=
# Публичный адрес демо (https://bcc.example.com): бот пришлёт родственнику ссылку на веб-кабинет.
PUBLIC_URL=
HOST=0.0.0.0
PORT=8000
# Внешний порт для docker compose (если 8000 занят на сервере)
BCC_PORT=8000
